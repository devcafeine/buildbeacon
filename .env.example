# BuildBeacon Hub — variables d'environnement (modèle). Copier en .env, qui n'est jamais versionné.
# Lu par mise run hub et par docker compose.
# Version 1.2 (2026-11-12) — Docker : le fichier sert aussi à docker compose.

# GitHub token, fine-grained, read-only: Actions: read + Metadata: read on the repositories
# you follow. Without it: public repositories only, 60 requests per hour.
# Jeton GitHub fine-grained en lecture seule : Actions: read + Metadata: read.
BB_GITHUB_TOKEN=

# Protects the writes of the REST API (Authorization: Bearer <token>). Empty: not protected.
# Protège les écritures de l'API REST (Authorization: Bearer <jeton>). Vide : non protégées.
BB_API_TOKEN=

# HTTP port and listening address of the API (default: 8080, 0.0.0.0 = all interfaces;
# 127.0.0.1 = this machine only).
# Port HTTP et adresse d'écoute de l'API (défaut : 8080, 0.0.0.0 = toutes les interfaces ;
# 127.0.0.1 = cette machine seulement).
BB_PORT=
BB_LISTEN=

# Folder of the web interface to serve (empty: the root / only presents the API; ignored
# by Docker, which serves its own).
# Dossier de l'interface web à servir (vide : la racine / présente seulement l'API ; ignoré
# par Docker, qui sert la sienne).
BB_WEB_DIR=

# Configuration file (default: /data/config.json; mise run hub uses data/config.json;
# ignored by Docker: /data/config.json in the buildbeacon-data volume).
# Fichier de configuration (défaut : /data/config.json ; mise run hub utilise
# data/config.json ; ignoré par Docker : /data/config.json dans le volume buildbeacon-data).
BB_CONFIG=

# Language of the command-line tools: en or fr (default: system language).
# Langue des outils en ligne de commande : en ou fr (défaut : langue du système).
BB_LANG=
