# BuildBeacon — files never to commit.
# Version 1.4 (2026-11-12) — comments in English.

# Secrets: the GitHub token only lives in .env (see .env.example).
.env
*.env
!.env.example

# Local working context (personal notes), not published.
CLAUDE.md

# Runtime data of the Hub (local config.json, Docker volume).
data/

# Dart / Flutter
.dart_tool/
build/
*.g.dart.tmp
.flutter-plugins-dependencies
# Web interface: translations generated from the ARB files (flutter pub get).
hub/ui/lib/l10n/app_localizations*.dart

# System / editors
.DS_Store
.idea/
.vscode/

# Hardware: KiCad temporary files, exports, Python
*-backups/
*.kicad_prl
fp-info-cache
_autosave-*
*.lck
hardware/**/gerbers/
__pycache__/
